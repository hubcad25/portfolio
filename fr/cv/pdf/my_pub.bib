@article{dery_etal22,
  title = {Sur Le Potentiel de Croissance Du {{Parti}} Conservateur Du {{Québec}}},
  author = {Déry, Axel and Bibeau, Alexis and Cadieux, Hubert and Dufresne, Yannick},
  date = {2022-12},
  journaltitle = {Canadian Journal of Political Science/Revue canadienne de science politique},
  volume = {55},
  number = {4},
  pages = {972--977},
  publisher = {Cambridge University Press},
  issn = {0008-4239, 1744-9324},
  doi = {10.1017/S0008423922000762},
  url = {https://www.cambridge.org/core/journals/canadian-journal-of-political-science-revue-canadienne-de-science-politique/article/sur-le-potentiel-de-croissance-du-parti-conservateur-du-quebec/150A578D7459A2DE6D18D95E1C41836F},
  urldate = {2023-10-10},
  abstract = {Depuis un an, le Parti conservateur du Québec (PCQ) a fait des gains considérables dans les sondages d'intention de vote. Le parti peut-il encore faire des gains ou a-t-il atteint son plein potentiel? Dans cette note de recherche, nous tentons de répondre à cette question en utilisant un nouvel indicateur, l'index relatif de confiance (IRC), qui permet de mesurer le potentiel de croissance et la solidité du vote des partis. , Abstract Over the past year, the Conservative Party of Quebec has made significant gains in polls. Can the party still make gains, or has it reached its full potential? In this research note, we attempt to answer this question using a new indicator, the Relative Confidence Index (RCI), which measures the potential for growth and solidity of the vote based on voters’ expressed likelihood to vote for the parties.},
  langid = {english},
  keywords = {article,Canadian politics,Conservative Party of Quebec,elections,élections,Parti conservateur du Québec,politique canadienne,politique québécoise,polling,Quebec politics,sondages},
  file = {/home/hubcad25/Dropbox/Zotero/storage/JYI3KDU8/Déry et al. - 2022 - Sur le potentiel de croissance du Parti conservate.pdf}
}

