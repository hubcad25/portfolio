@article{cadieux_etal24,
  title = {Electoral Dynamics in {{Quebec}}: Analyzing the Rise of the {{Parti Qu\'eb\'ecois}} through the Lens of Potential for Growth},
  shorttitle = {Electoral Dynamics in {{Quebec}}},
  author = {Cadieux, Hubert and Ouellet, Catherine and Vincent, Sarah-Jane and Gilbert, J{\'e}r{\'e}my and Pelletier, Camille and Dufresne, Yannick},
  year = 2024,
  month = dec,
  journal = {French Politics},
  issn = {1476-3427},
  doi = {10.1057/s41253-024-00274-z},
  urldate = {2025-01-16},
  abstract = {In the complex landscape of multiparty electoral systems, accurately capturing shifts in voter preferences poses significant challenges. Traditional polling methods, which rely heavily on basic vote intention metrics, often fail to predict substantial changes in voter support. A notable example is the recent resurgence of the Parti Qu\'eb\'ecois (PQ) in Quebec, which reached levels of support unseen since 1988. This resurgence, alongside other unexpected electoral outcomes, underscores the limitations of conventional forecasting methods. By examining the Quebec political scene post-2022 election, this research note assesses the effectiveness of the Relative Confidence Index (RCI), an innovative yet underutilized metric, in quantifying parties' potential for growth. Findings suggest that the RCI could have provided early insight into the PQ's unexpected resurgence. More broadly, the study argues that the RCI addresses a critical gap in traditional vote choice measurement by offering detailed insights into voter likelihoods and party preferences, thereby fulfilling the need for more accurate and informative measures in multiparty systems.},
  copyright = {All rights reserved},
  langid = {english},
  keywords = {article,Election forecasting,Electoral dynamics,Multiparty systems,Quebec politics,Relative Confidence Index (RCI)},
  file = {/home/hubcad25/Zotero/storage/S6QE54UF/Cadieux et al. - 2024 - Electoral dynamics in Quebec analyzing the rise of the Parti Québécois through the lens of potentia.pdf}
}

@article{dery_etal22,
  title = {Sur Le Potentiel de Croissance Du {{Parti}} Conservateur Du {{Qu\'ebec}}},
  author = {D{\'e}ry, Axel and Bibeau, Alexis and Cadieux, Hubert and Dufresne, Yannick},
  year = 2022,
  month = dec,
  journal = {Canadian Journal of Political Science/Revue canadienne de science politique},
  volume = {55},
  number = {4},
  pages = {972--977},
  publisher = {Cambridge University Press},
  issn = {0008-4239, 1744-9324},
  doi = {10.1017/S0008423922000762},
  urldate = {2023-10-10},
  abstract = {Depuis un an, le Parti conservateur du Qu\'ebec (PCQ) a fait des gains consid\'erables dans les sondages d'intention de vote. Le parti peut-il encore faire des gains ou a-t-il atteint son plein potentiel? Dans cette note de recherche, nous tentons de r\'epondre \`a cette question en utilisant un nouvel indicateur, l'index relatif de confiance (IRC), qui permet de mesurer le potentiel de croissance et la solidit\'e du vote des partis. , Abstract Over the past year, the Conservative Party of Quebec has made significant gains in polls. Can the party still make gains, or has it reached its full potential? In this research note, we attempt to answer this question using a new indicator, the Relative Confidence Index (RCI), which measures the potential for growth and solidity of the vote based on voters' expressed likelihood to vote for the parties.},
  copyright = {All rights reserved},
  langid = {english},
  keywords = {article,Canadian politics,Conservative Party of Quebec,elections,Parti conservateur du Quebec,politique canadienne,politique quebecoise,polling,Quebec politics,sondages},
  file = {/home/hubcad25/Zotero/storage/JYI3KDU8/Déry et al. - 2022 - Sur le potentiel de croissance du Parti conservate.pdf;/home/hubcad25/Zotero/storage/XBRBCEZT/sur-le-potentiel-de-croissance-du-parti-conservateur-du-quebec.pdf}
}

