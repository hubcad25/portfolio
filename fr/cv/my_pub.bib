@article{marland12,
  title = {Political {{Photography}}, {{Journalism}}, and {{Framing}} in the {{Digital Age}}: {{The Management}} of {{Visual Media}} by the {{Prime Minister}} of {{Canada}}},
  shorttitle = {Political {{Photography}}, {{Journalism}}, and {{Framing}} in the {{Digital Age}}},
  author = {Marland, Alex},
