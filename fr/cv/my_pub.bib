@phdthesis{pirnay01,
  type = {These de Doctorat},
  title = {La Valorisation Economique Des Resultats de Recherche Universitaire Par Creation d'activites Nouvelles (Spin-Offs Universitaires) : Proposition d'un Cadre Procedutal d'essaimage},
  shorttitle = {La Valorisation Economique Des Resultats de Recherche Universitaire Par Creation d'activites Nouvelles (Spin-Offs Universitaires)},
  author = {PIRNAY, {\relax FABRICE}},
  year = 2001,
  month = jan,
  urldate = {2024-07-30},
  abstract = {Notre recherche a pour objet les entreprises creees au depart d'institutions universitaires en vue d'exploiter les perspectives commercialement prometteuses de certaines connaissances produites en leur sein. Ces entreprises sont egalement connues sous le terme anglo-saxon de "spin-off universitaire". Pour aborder cet objet d'etude, nous avons choisi d'adopter le point de vue des autorites academiques desireuses de mettre en place au sein de leurs institutions respectives une politique d'essaimage destinee a promouvoir la creation et assurer le developpement de telles entreprises. Ce choix s'explique par le fait que les universites disposent d'un important stock de connaissances ainsi que de nombreux resultats de recherches presentant un potentiel d'applications economiques non negligeabledont elles entendent desormais encourager l'exploitation economique par la creation d'entreprises a fort potentiel de croissance. Or, nombre d'entre elles sont prises au depourvu des lors qu'il s'agit de passer de l'intention a l'action. La plupart des autorites academiques ne disposent d'aucune reference pratique pour les aider dans leur demarche, ni d'aucun repere theorique pour les orienter dans leur reflexion. C'est pourquoi notre projet de recherche entend construire de nouvelles connaissances qui soient utiles et actionnables pour les autorites academiques soucieuses de developper en leur sein une politique d'essaimage. Au depart d'observations realisees au sein de 15 universites internationalement reputees pour leur dynamisme en la matiere, nous proposons un cadre procedural d'essaimage compose de deux parties : l'une decrivant les problemes auxquels les autorites academiques desireuses de mettre en place une politique d'essaimage en leur sein se doivent d'etre attentives, l'autre s'interessant aux dispositifs institutionnels et aux differents acteurs susceptibles de jouer un role significatif dans une telle politique.},
  collaborator = {Aliouat, Boualem},
  copyright = {Licence Etalab},
  school = {Lille 2},
  keywords = {Industrie et education}
}

