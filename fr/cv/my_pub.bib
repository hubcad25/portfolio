  volume = {12},
  number = {1},
  pages = {5485},
  issn = {2045-2322},
  doi = {10.1038/s41598-022-09165-1},
  urldate = {2025-10-17},
  abstract = {Abstract             This paper explores the abstraction of classical physics and applies several metrics that explore the evolution of social opinion. These metrics include an abstraction of Newtonian kinematics: mass, position, speed, acceleration, and Newtonian dynamics, an abstraction of force. Poll data is fit to a 2nd-order polynomial and a logistic function. These fits are used to understand the acceleration of opinion shift, and we explore recent social, cultural, and environmental trends, such as views on global climate change. We compare our results with the evolution of communication technologies and time spent on devices over the past 120 years. We show that the model connects the evolution in opinion with an abstraction of a Galilean concept: acceleration is independent of mass. Finally, we discuss the model of social polarization and the non-linear effect of media such as echo chambers.},
  langid = {english},
  file = {/home/hubcad25/Zotero/storage/ASMZVYMQ/Zachary - 2022 - Modelling shifts in social opinion through an application of classical physics.pdf}
}

