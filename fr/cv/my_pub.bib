@article{boulay12,
  title = {{Cours12\_Exploration du ph\'enom\`ene d'astroturfing : une strat\'egie de communication usurpant l'identit\'e citoyenne dans l'espace public}},
  shorttitle = {{Exploration du ph\'enom\`ene d'astroturfing}},
  author = {Boulay, Sophie},
  year = 2012,
