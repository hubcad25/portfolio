  issn = {2398-063X, 2398-0648},
  doi = {10.1017/bpp.2018.28},
  urldate = {2023-07-19},
  abstract = {Abstract             There is an inherent conflict between the political marketing model of humans and pioneering theories in electoral behavior research. While political marketing logic implies an issue-based and highly volatile voting behavior, voting theories conventionally assume that positional issues have little effect on how individuals vote, and so parties have little incentive to develop issue-based electoral strategies. However, few people would challenge the role that marketing now plays in the modern campaign process. How can we reconcile these theories? This paper revisits the role and impact of positional issues on voting behavior by testing whether specific issues affect different subgroups of voters as contended by the `issue-public' theory. The results show that previous models underestimate issue voting. Once measurement accuracy is improved and the salience-based heterogeneity of issue effects is taken into consideration, positional issues have non-negligible effects on individual vote choice. Furthermore, salience-based heterogeneity is shown to explain better the variation in issue voting than heterogeneity based on political sophistication.},
  langid = {english},
  file = {/home/hubcad25/Zotero/storage/7AAJ68U7/Dufresne_Ouellet_2021_Public issues or issue publics.pdf;/home/hubcad25/Zotero/storage/XXHM7V98/_.pdf}
}

