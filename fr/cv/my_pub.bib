@article{rosen_etal01,
  title = {Bayesian and {{Frequentist Inference}} for {{Ecological Inference}}: {{The R}}\texttimes{{C Case}}},
  shorttitle = {Bayesian and {{Frequentist Inference}} for {{Ecological Inference}}},
  author = {Rosen, Ori and Jiang, Wenxin and King, Gary and Tanner, Martin A.},
  year = 2001,
  journal = {Statistica Neerlandica},
  volume = {55},
  number = {2},
  pages = {134--156},
  issn = {1467-9574},
  doi = {10.1111/1467-9574.00162},
  urldate = {2024-11-19},
  abstract = {In this paper we propose Bayesian and frequentist approaches to ecological inference, based on R\texttimes C contingency tables, including a covariate. The proposed Bayesian model extends the binomial-beta hierarchical model developed by King, Rosen and Tanner (1999) from the 2\texttimes 2 case to the R\texttimes C case. As in the 2\texttimes 2 case, the inferential procedure employs Markov chain Monte Carlo (MCMC) methods. As such, the resulting MCMC analysis is rich but computationally intensive. The frequentist approach, based on first moments rather than on the entire likelihood, provides quick inference via nonlinear least-squares, while retaining good frequentist properties. The two approaches are illustrated with simulated data, as well as with real data on voting patterns in Weimar Germany. In the final section of the paper we provide an overview of a range of alternative inferential approaches which trade-off computational intensity for statistical efficiency.},
  copyright = {Blackwell Publishers Ltd 2001},
  langid = {english},
  keywords = {bayesian,frequentiste},
  file = {/home/hubcad25/Zotero/storage/6FI99V9F/Rosen et al. - 2001 - Bayesian and Frequentist Inference for Ecological Inference The R×C Case.pdf;/home/hubcad25/Zotero/storage/3WKAWJCH/1467-9574.html}
}

@article{roy_mcgrane15,
