>Strongly in favor<br />of Quebec becoming<br />a sovereign country\",\"hoverinfo\":\"text\",\"legendgroup\":\"QS\",\"marker\":{\"color\":\"rgba(255,86,5,1)\",\"size\":40,\"symbol\":\"diamond\",\"opacity\":0.29999999999999999,\"line\":{\"color\":\"rgba(255,86,5,1)\"}},\"showlegend\":false,\"name\":\"QS\",\"textfont\":{\"color\":\"rgba(255,86,5,1)\"},\"error_y\":{\"color\":\"rgba(255,86,5,1)\"},\"error_x\":{\"color\":\"rgba(255,86,5,1)\"},\"line\":{\"color\":\"rgba(255,86,5,1)\"},\"xaxis\":\"x\",\"yaxis\":\"y\",\"frame\":null},{\"x\":[\"0\",\"0.33\",\"0.67\",\"1\"],\"y\":[-0.65247314840687731,-0.56060950409078292,-0.58399215094776591,-0.66477396732912131],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"rgba(0,204,204,1)\",\"width\":1},\"showlegend\":false,\"legendgroup\":\"CAQ\",\"hoverinfo\":[\"none\",\"none\",\"none\",\"none\"],\"name\":\"CAQ\",\"marker\":{\"color\":\"rgba(0,204,204,1)\",\"line\":{\"color\":\"rgba(0,204,204,1)\"}},\"textfont\":{\"color\":\"rgba(0,204,204,1)\"},\"error_y\":{\"color\":\"rgba(0,204,204,1)\"},\"error_x\":{\"color\":\"rgba(0,204,204,1)\"},\"xaxis\":\"x\",\"yaxis\":\"y\",\"frame\":null},{\"x\":[\"0\",\"0.33\",\"0.67\",\"1\"],\"y\":[-0.78473280487200014,-0.77820937578178562,-0.84777785009743778,-0.90065238847763984],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"rgba(160,32,240,1)\",\"width\":1},\"showlegend\":false,\"legendgroup\":\"PCQ\",\"hoverinfo\":[\"none\",\"none\",\"none\",\"none\"],\"name\":\"PCQ\",\"marker\":{\"color\":\"rgba(160,32,240,1)\",\"line\":{\"color\":\"rgba(160,32,240,1)\"}},\"textfont\":{\"color\":\"rgba(160,32,240,1)\"},\"error_y\":{\"color\":\"rgba(160,32,240,1)\"},\"error_x\":{\"color\":\"rgba(160,32,240,1)\"},\"xaxis\":\"x\",\"yaxis\":\"y\",\"frame\":null},{\"x\":[\"0\",\"0.33\",\"0.67\",\"1\"],\"y\":[-0.66397210963992237,-0.64747620402576467,-0.74340124968060062,-0.86041889227894175],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"rgba(237,26,45,1)\",\"width\":1},\"show